MONGO_URI=mongodb://127.0.0.1:27017/mediflow
# Disposable integration tests use their own allowlisted JSON config, never this URI.
JWT_SECRET=replace-with-a-long-random-secret
# Optional for startup; required only for Gemini assistance. Manual discovery works without it.
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Optional model override; verify model availability for your provider account.
GEMINI_MODEL=gemini-2.5-flash
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Direct local server: 0. Set only to the verified trusted proxy hop count on hosting.
TRUST_PROXY_HOPS=0
CLINIC_TIMEZONE_OFFSET=+05:30
# Required only when running the development doctor seed script.
DEMO_DOCTOR_PASSWORD=replace-with-a-local-demo-password
# Legacy bootstrap aliases; prefer ADMIN_* below. No default administrator.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_NAME=

# Optional email verification/recovery. Signup/login never require email.
AUTH_EMAIL_ENABLED=false
# Configure only after approving real email delivery.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=

# Explicit administrator bootstrap only (never run automatically).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_PHONE=

# For ephemeral free hosting use false. Text records remain available.
MEDICAL_UPLOADS_ENABLED=true
# Development default is backend/uploads. Production uploads require an absolute
# private persistent mounted path, or MEDICAL_UPLOADS_ENABLED=false. Never serve statically.
UPLOADS_DIRECTORY=
